<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Base.Theme.FootballClubDetails" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="android:statusBarColor">@color/windowBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.FootballClubDetails" parent="Base.Theme.FootballClubDetails" />

    <style name="TextAppearance.App.Heading" parent="Theme.FootballClubDetails">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.App.Subtitle" parent="Theme.FootballClubDetails">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/secondaryTextColor</item>
    </style>

    <style name="TextAppearance.App.Title" parent="Theme.FootballClubDetails">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primaryTextColor</item>
    </style>


    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5%</item>
    </style>

    <style name="TextAppearance.App.Body" parent="Theme.FootballClubDetails">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="SplashTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="postSplashScreenTheme">@style/Theme.FootballClubDetails</item>
    </style>

    <style name="SearchBarTheme" parent="Theme.FootballClubDetails">
        <item name="android:textColor">#757575</item>
    </style>
</resources>